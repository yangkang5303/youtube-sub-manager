# ──────────────────────────────────────────────────────────────────────
# 复制成 .env 后按需修改：  cp .env.example .env
# docker compose 会自动读取同目录下的 .env，用来填充 docker-compose.yml
# 里的 ${变量}。所有项都有默认值，不填也能跑。
# ──────────────────────────────────────────────────────────────────────

# ── 基础 ──

# Web 界面端口（宿主机侧）。改成别的记得用新端口访问。
# 注意：只改这里不够，还要同步改 docker-compose.yml 里 ports 的左侧值。
APP_PORT=8765

# 时区，影响日志时间戳
TZ=Asia/Shanghai

# ── 数据缓存 ──

# 本地快照的「新鲜度」阈值（秒）。超过它，下次打开页面才重新调 YouTube API。
# 默认 6 小时。调小 = 数据更新更快，但更费 API 配额。
REFRESH_INTERVAL_SECONDS=21600

# 后台定时刷新间隔（秒）。0 = 关闭（默认），即「不打开页面就不消耗配额」。
# 想保持数据常新可设 7200（每 2 小时，约占日配额 32%）。
AUTO_REFRESH_SECONDS=0

# ── 访问保护（强烈建议对外暴露时开启）──
#
# 本应用没有账号体系：任何能访问该地址的人都能查看你的全部订阅，
# 并且可以真的退订你的频道。设了密码后浏览器会弹原生登录框。
# 留空 = 不启用。
ACCESS_USER=admin
ACCESS_PASSWORD=

# ── OAuth 授权（一般不用改）──
#
# 回调端口。必须和 docker-compose.yml 里 ports 的映射保持两处一致。
OAUTH_PORT=8899
# 容器内必须绑 0.0.0.0 才能被端口映射转发
OAUTH_BIND_ADDR=0.0.0.0
# 容器里没有浏览器，保持 0
OAUTH_OPEN_BROWSER=0
# 等待 Google 回调的超时秒数，超时后自动释放回调端口
OAUTH_TIMEOUT_SECONDS=600
# 只有用 Tailscale Serve 之类提供 HTTPS 域名、且 OAuth 客户端是「Web 应用」
# 类型时才需要设置，例如 https://myhost.example.ts.net/
# OAUTH_REDIRECT_URI=
